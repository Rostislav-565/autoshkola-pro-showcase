{
  "name": "autoshkola-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "migrate": "node --disable-warning=ExperimentalWarning src/migrate.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.ts",
    "admin": "node --disable-warning=ExperimentalWarning src/admin.ts",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node --disable-warning=ExperimentalWarning build/server.js",
    "start": "node --disable-warning=ExperimentalWarning build/server.js",
    "verify": "node --disable-warning=ExperimentalWarning scripts/verify.mjs",
    "verify:browser": "node --disable-warning=ExperimentalWarning scripts/verify-browser.mjs"
  }
}
